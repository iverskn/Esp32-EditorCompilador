{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://esp32ide.com/schemas/compile-response.json",
  "title": "CompileResponse",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "hexBinary": { 
      "type": ["string", "null"],
      "description": "Binario compilado codificado en Base64 (solo en éxito)" 
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "message": { "type": "string" }
        },
        "required": ["file", "line", "column", "severity", "message"]
      }
    }
  },
  "required": ["success", "message", "errors"]
}